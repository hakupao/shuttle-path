---
interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
const year = new Date().getFullYear();
const featherTone = isHome ? '' : '-dark';
---

<footer class:list={[
  "relative overflow-hidden",
  isHome ? "bg-court-surround" : "bg-paper-dark/50",
]}>
  <!-- 装饰碎片 -->
  <img
    src={`/images/decorations/feather-1${featherTone}.png`}
    alt=""
    width="32"
    height="32"
    decoding="async"
    aria-hidden="true"
    class:list={["absolute top-6 right-[10%] size-8 rotate-12 object-contain", isHome ? "opacity-[0.10]" : "opacity-[0.08]"]}
  />
  <img
    src={`/images/decorations/feather-2${featherTone}.png`}
    alt=""
    width="24"
    height="24"
    decoding="async"
    aria-hidden="true"
    class:list={["absolute bottom-10 left-[8%] size-6 -rotate-[20deg] object-contain", isHome ? "opacity-[0.08]" : "opacity-[0.07]"]}
  />
  <img
    src={`/images/decorations/feather-3${featherTone}.png`}
    alt=""
    width="28"
    height="28"
    decoding="async"
    aria-hidden="true"
    class:list={["absolute bottom-6 right-[22%] size-7 rotate-[28deg] object-contain", isHome ? "opacity-[0.06]" : "opacity-[0.05]"]}
  />

  <div class:list={[
    "mx-auto px-(--spacing-page) relative",
    isHome ? "max-w-6xl pt-6 pb-6" : "max-w-6xl pt-12 pb-8",
  ]}>
    {isHome ? (
      <!-- 首页：简洁的 surround 区域页脚 -->
      <div class="flex items-center justify-between text-xs text-white/35">
        <span class="font-display text-sm text-white/50">Shuttle Path</span>
        <div class="flex items-center gap-3">
          <a href="/knowledge/" class="hover:text-white/70 transition-colors">知识库</a>
          <span class="text-white/15">·</span>
          <a href="/lessons/" class="hover:text-white/70 transition-colors">教学日记</a>
          <span class="text-white/15">·</span>
          <a href="https://github.com/hakupao" target="_blank" rel="noopener noreferrer" class="hover:text-white/70 transition-colors">GitHub</a>
        </div>
      </div>
    ) : (
      <!-- 其他页面：完整页脚 -->
      <Fragment>
        <div class="divider-wavy mb-10"></div>

        <div class="text-center mb-8">
          <a href="/" class="font-display text-lg text-ink hover:text-court transition-colors inline-block mb-3">
            Shuttle Path
          </a>
          <p class="text-sm text-ink-muted max-w-xs mx-auto leading-relaxed">
            一个羽毛球爱好者的教学笔记与知识库
          </p>
        </div>

        <div class="flex items-center justify-center gap-2 text-sm text-ink-muted mb-8">
          <a href="/knowledge/" class="hover:text-court transition-colors">知识库</a>
          <span class="text-ink-muted/40">·</span>
          <a href="/lessons/" class="hover:text-court transition-colors">教学日记</a>
          <span class="text-ink-muted/40">·</span>
          <a href="https://github.com/hakupao" target="_blank" rel="noopener noreferrer" class="hover:text-court transition-colors inline-flex items-center gap-1">
            GitHub
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="opacity-40">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-ink-muted/60">
          <p>&copy; {year} Shuttle Path</p>
          <p>
            Made with
            <span class="inline-block mx-0.5 text-coral" aria-label="heart">&#9829;</span>
            by <a href="https://github.com/hakupao" target="_blank" rel="noopener noreferrer" class="hover:text-court transition-colors">hakupao</a>
          </p>
        </div>
      </Fragment>
    )}
  </div>
</footer>
